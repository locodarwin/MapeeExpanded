<UserControl x:Class="Mapper.Gui.MarkupItemEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="262">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Template/ToolTip.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- A round colour; Tag "selected" rings it in white -->
            <Style x:Key="Swatch" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="24"/>
                <Setter Property="Height" Value="24"/>
                <Setter Property="Margin" Value="0, 0, 6, 0"/>
                <Setter Property="BorderBrush" Value="#FF303030"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="2" CornerRadius="12"/>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="selected">
                        <Setter Property="BorderBrush" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- A pin symbol; Tag "selected" marks it in gold, as the height panel marks its mode -->
            <Style x:Key="IconButton" TargetType="{x:Type Button}">
                <Setter Property="Width" Value="25"/>
                <Setter Property="Height" Value="25"/>
                <Setter Property="Margin" Value="0, 0, 3, 0"/>
                <Setter Property="Background" Value="#FF303030"/>
                <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF404040"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="selected">
                        <Setter Property="BorderBrush" Value="Gold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="DialogButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="25"/>
                <Setter Property="MinWidth" Value="64"/>
                <Setter Property="Margin" Value="6, 0, 0, 0"/>
                <Setter Property="Padding" Value="8, 0"/>
                <Setter Property="Foreground" Value="#FFEEEEEE"/>
                <Setter Property="Background" Value="#FF353535"/>
                <Setter Property="BorderBrush" Value="#FF454545"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF454545"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF606060"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Caption" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFAAAAAA"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Margin" Value="0, 8, 0, 3"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#FF1C1C1C" BorderBrush="#FF707070" BorderThickness="1" Padding="10, 8, 10, 10">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleText" Text="New pin" FontSize="14" FontWeight="Bold" Foreground="#FFEEEEEE"/>
                <TextBlock x:Name="WhereText" Grid.Column="1" Foreground="#FFAAAAAA" FontSize="11" VerticalAlignment="Center"/>
            </Grid>

            <TextBlock Style="{StaticResource Caption}" Text="Label"/>
            <TextBox x:Name="LabelBox" Height="26" FontSize="13" Padding="3, 2, 3, 0" MaxLength="80"/>

            <TextBlock Style="{StaticResource Caption}" Text="Colour"/>
            <StackPanel x:Name="Swatches" Orientation="Horizontal"/>

            <StackPanel x:Name="IconSection">
                <TextBlock Style="{StaticResource Caption}" Text="Symbol"/>
                <StackPanel x:Name="IconButtons" Orientation="Horizontal"/>
            </StackPanel>

            <TextBlock Style="{StaticResource Caption}" Text="Note"/>
            <TextBox x:Name="NoteBox" Height="52" FontSize="12" Padding="3, 2, 3, 0" AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" MaxLength="1000"/>

            <Grid Margin="0, 10, 0, 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DeleteButton" Style="{StaticResource DialogButton}" Margin="0" Content="Delete" Click="DeleteButton_Click"/>
                <Button x:Name="CancelButton" Grid.Column="2" Style="{StaticResource DialogButton}" Content="Cancel" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Grid.Column="3" Style="{StaticResource DialogButton}" Content="Save" Click="SaveButton_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
