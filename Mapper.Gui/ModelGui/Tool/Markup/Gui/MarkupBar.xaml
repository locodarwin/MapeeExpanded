<UserControl x:Class="Mapper.Gui.MarkupBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             BorderBrush="#FF3F3F3F" BorderThickness="1">

    <UserControl.Effect>
        <DropShadowEffect Direction="-75" ShadowDepth="2" Opacity="5" BlurRadius="6" Color="Black"/>
    </UserControl.Effect>

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Template/ToolTip.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Tag "selected" marks the current mode in gold, as the height panel marks its mode -->
            <Style x:Key="ModeButton" TargetType="{x:Type Button}">
                <Setter Property="Height" Value="22"/>
                <Setter Property="Margin" Value="0, 0, 4, 0"/>
                <Setter Property="Padding" Value="8, 0"/>
                <Setter Property="FontSize" Value="12"/>
                <Setter Property="Foreground" Value="#FFDDDDDD"/>
                <Setter Property="Background" Value="#FF303030"/>
                <Setter Property="BorderBrush" Value="#FF3F3F3F"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="ToolTipService.InitialShowDelay" Value="200"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF404040"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF505050"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#FF6A6A6A"/>
                    </Trigger>
                    <Trigger Property="Tag" Value="selected">
                        <Setter Property="Foreground" Value="Gold"/>
                        <Setter Property="BorderBrush" Value="Gold"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="Gap" TargetType="{x:Type Border}">
                <Setter Property="Width" Value="1"/>
                <Setter Property="Margin" Value="4, 2, 8, 2"/>
                <Setter Property="Background" Value="#FF3F3F3F"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Background="#FF1C1C1C">
        <StackPanel Orientation="Horizontal" Margin="6, 5, 2, 4">
            <Button x:Name="PinButton" Style="{StaticResource ModeButton}" Content="Pin" Click="PinButton_Click"/>
            <Button x:Name="ZoneButton" Style="{StaticResource ModeButton}" Content="Zone" Click="ZoneButton_Click"/>
            <Button x:Name="RectangleButton" Style="{StaticResource ModeButton}" Content="Rectangle" Click="RectangleButton_Click"/>
            <Button x:Name="SelectButton" Style="{StaticResource ModeButton}" Content="Select" Click="SelectButton_Click"/>
            <Border Style="{StaticResource Gap}"/>
            <Button x:Name="PlacesButton" Style="{StaticResource ModeButton}" Content="Places" Click="PlacesButton_Click" ToolTip="Every pin and zone in this dimension"/>
            <Button x:Name="UndoButton" Style="{StaticResource ModeButton}" Content="Undo" Click="UndoButton_Click" ToolTip="Undo (Ctrl+Z)"/>
            <Button x:Name="RedoButton" Style="{StaticResource ModeButton}" Content="Redo" Click="RedoButton_Click" ToolTip="Redo (Ctrl+Y)"/>
            <Border Style="{StaticResource Gap}"/>
            <Button x:Name="ExportButton" Style="{StaticResource ModeButton}" Content="Export..." Click="ExportButton_Click" ToolTip="Save this world's markup to a file"/>
            <Button x:Name="ImportButton" Style="{StaticResource ModeButton}" Content="Import..." Click="ImportButton_Click" ToolTip="Add the markup saved in a file"/>
            <Button x:Name="HideButton" Style="{StaticResource ModeButton}" Content="Hide" Click="HideButton_Click"/>
        </StackPanel>
        <TextBlock x:Name="HintText" Foreground="#FFAAAAAA" FontSize="11" Margin="7, 0, 7, 5" TextWrapping="Wrap" MaxWidth="560" HorizontalAlignment="Left"/>

        <Popup x:Name="EditPopup" Placement="Relative" StaysOpen="False" AllowsTransparency="True"/>

        <Popup x:Name="PlacesPopup" Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
            <Border Background="#FF1C1C1C" BorderBrush="#FF707070" BorderThickness="1" Width="300">
                <StackPanel>
                    <TextBox x:Name="PlacesFilter" Height="24" Margin="6" FontSize="12" Padding="3, 2, 3, 0"/>
                    <TextBlock x:Name="PlacesEmpty" Foreground="#FFAAAAAA" FontSize="12" Margin="8, 0, 8, 8" TextWrapping="Wrap"
                               Text="Nothing marked in this dimension yet."/>
                    <ListBox x:Name="PlacesList" MaxHeight="320" Background="Transparent" BorderThickness="0" Margin="0, 0, 0, 4"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
