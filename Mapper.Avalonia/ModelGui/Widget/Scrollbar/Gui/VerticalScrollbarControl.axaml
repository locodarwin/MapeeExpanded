<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mapper.Gui.VerticalScrollbarControl"
             Background="#FF141414">
    <DockPanel Margin="0,7,0,2">
        <ScrollBar x:Name="ScrollbarControl" Orientation="Vertical" Background="{x:Null}" />
    </DockPanel>
</UserControl>
