<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:gui="using:Mapper.Gui"
        xmlns:m="using:Mapper"
        x:Class="Mapper.Gui.FindWindow"
        UseLayoutRounding="True"
        Icon="avares://Mapee/Resources/Icon/ToolButton/Find_64px.ico"
        Title="Find" Height="720" Width="460" MinWidth="380" MinHeight="520" Background="#FF232323" WindowStartupLocation="CenterOwner">

    <Window.Styles>
        <Style Selector="ListBox.list">
            <Setter Property="Background" Value="#FF191919" />
        </Style>
        <Style Selector="ListBox.list ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Foreground" Value="#FFEEEEEE" />
        </Style>
        <Style Selector="Button.group">
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="Height" Value="24" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="#FFBBBBBB" />
        </Style>
        <Style Selector="Button.half">
            <Setter Property="Width" Value="90" />
            <Setter Property="Height" Value="26" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.half.on">
            <Setter Property="BorderBrush" Value="#FFE0B040" />
            <Setter Property="Foreground" Value="#FFE0B040" />
        </Style>
    </Window.Styles>

    <!-- Blocks, signs or pets: a switch on top, and the part picked below it -->
    <Grid Margin="15,10,15,15" RowDefinitions="Auto,*">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" Margin="0,0,0,4">
            <Button x:Name="BlocksButton" Classes="dialog half" Content="Blocks" Click="BlocksButton_Click" ToolTip.Tip="Find blocks anywhere in the dimension" />
            <Button x:Name="SignsButton" Classes="dialog half" Content="Signs" Click="SignsButton_Click" ToolTip.Tip="List the signs and what they say, and pick which to show on the map" />
            <Button x:Name="PetsButton" Classes="dialog half" Content="Pets" Click="PetsButton_Click" ToolTip.Tip="List the mobs given a name, and pick which to show on the map" />
        </StackPanel>

        <Grid Grid.Row="1" x:Name="BlocksHalf" RowDefinitions="Auto,Auto,110,Auto,Auto,Auto,Auto,Auto,Auto,Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="Look for" Classes="heading" Margin="0,4,0,4" />
            <TextBox Grid.Row="1" x:Name="SearchBox" PlaceholderText="Search blocks (Enter or double-click adds one)" FontSize="13" Height="25" Padding="4,1,0,0" />
            <ListBox Grid.Row="2" x:Name="BlockList" Classes="list" Margin="0,3,0,0">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="gui:FindBlockRow">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Text="{Binding Id}" Classes="dim" FontSize="11" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <ItemsControl Grid.Row="3" x:Name="GroupButtons" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="m:FindTarget">
                        <Button Classes="dialog group" Content="{Binding Label}" Click="GroupButton_Click" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="4" x:Name="ChipList" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="gui:FindChip">
                        <Border Background="#FF303030" BorderBrush="#FF505050" BorderThickness="1" CornerRadius="3" Margin="0,0,5,5" Padding="6,2,2,2" ToolTip.Tip="{Binding ToolTip}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Label}" Foreground="#FFEEEEEE" VerticalAlignment="Center" />
                                <Button Classes="flat" Content="×" Padding="5,0" FontSize="14" ToolTip.Tip="Take it off" Click="RemoveChip_Click" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0">
                <TextBlock Text="From Y" VerticalAlignment="Center" />
                <TextBox x:Name="FromBox" Width="64" Height="25" Padding="4,1,0,0" PlaceholderText="any" />
                <TextBlock Text="to Y" VerticalAlignment="Center" Margin="4,0,0,0" />
                <TextBox x:Name="ToBox" Width="64" Height="25" Padding="4,1,0,0" PlaceholderText="any" />
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                <Button x:Name="FindButton" Content="Find" Classes="dialog" Width="90" Height="26" HorizontalContentAlignment="Center" BorderBrush="#FF528753" Click="FindButton_Click" />
                <Button x:Name="StopButton" Content="Stop" Classes="dialog" Width="70" Height="26" HorizontalContentAlignment="Center" Click="StopButton_Click" />
            </StackPanel>
            <TextBlock Grid.Row="7" x:Name="StatusText" Classes="dim" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ProgressBar Grid.Row="8" x:Name="Progress" Height="4" MinHeight="4" Margin="0,4,0,0" Minimum="0" Maximum="1" />

            <Grid Grid.Row="9" ColumnDefinitions="*,Auto" Margin="0,6,0,3">
                <TextBlock x:Name="CountsText" Classes="dim" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>

            <Border Grid.Row="10" BorderBrush="#FF404040" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF262626" Height="25">
                        <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,0">
                            <TextBlock x:Name="SortedText" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="SortButton" Classes="flat" Content="Sort from the map's middle" FontSize="12" Padding="6,1" Click="SortButton_Click"
                                    ToolTip.Tip="List the nearest to the middle of the map first, from where it is now" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="ResultList" Classes="list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="gui:FindResultRow">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" />
                                        <TextBlock Text="{Binding Place}" Classes="dim" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Distance}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="11" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                <Button x:Name="GoButton" Content="Go there" Classes="dialog" Width="90" Height="26" HorizontalContentAlignment="Center" Click="GoButton_Click" />
                <Button x:Name="PinButton" Content="Add a pin" Classes="dialog" Width="90" Height="26" HorizontalContentAlignment="Center" Click="PinButton_Click"
                        ToolTip.Tip="Put a pin on it, labelled with what it is and how deep" />
                <TextBlock x:Name="PinnedText" Classes="dim" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- Nothing is drawn for a sign until its box is ticked -->
        <Grid Grid.Row="1" x:Name="SignsHalf" IsVisible="False" RowDefinitions="Auto,Auto,Auto,Auto,Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="Signs in this dimension" Classes="heading" Margin="0,4,0,4" />
            <TextBox Grid.Row="1" x:Name="SignSearchBox" PlaceholderText="Only signs saying these words (either side)" FontSize="13" Height="25" Padding="4,1,0,0" />
            <CheckBox Grid.Row="2" x:Name="BlankBox" Content="Include blank signs" Margin="0,6,0,0" />
            <TextBlock Grid.Row="3" x:Name="SignStatusText" Classes="dim" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ProgressBar Grid.Row="4" x:Name="SignProgress" Height="4" MinHeight="4" Margin="0,4,0,6" IsIndeterminate="True" />

            <Border Grid.Row="5" BorderBrush="#FF404040" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF262626" Height="25">
                        <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,0">
                            <TextBlock x:Name="SignSortedText" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="SignSortButton" Classes="flat" Content="Sort from the map's middle" FontSize="12" Padding="6,1" Click="SignSortButton_Click"
                                    ToolTip.Tip="List the nearest to the middle of the map first, from where it is now" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="SignList" Classes="list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="gui:SignRow">
                                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding ToolTip}">
                                    <CheckBox IsChecked="{Binding Shown, Mode=TwoWay}" IsEnabled="{Binding CanShow}" VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip.Tip="Show it on the map" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding More}" IsVisible="{Binding HasMore}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Place}" Classes="dim" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Distance}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <WrapPanel Grid.Row="6" Margin="0,8,0,0">
                <Button x:Name="ShowListedButton" Content="Show all listed" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="ShowListedButton_Click"
                        ToolTip.Tip="Tick every sign in the list" />
                <Button x:Name="HideAllButton" Content="Hide all" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="HideAllButton_Click"
                        ToolTip.Tip="Take every sign in this dimension off the map" />
                <Button x:Name="SignGoButton" Content="Go there" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="SignGoButton_Click" />
                <Button x:Name="SignPinButton" Content="Add a pin" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="SignPinButton_Click"
                        ToolTip.Tip="Put a pin on it, labelled with its first line" />
                <TextBlock x:Name="SignPinnedText" Classes="dim" VerticalAlignment="Center" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>

        <!-- Nothing is drawn for a named mob until its box is ticked -->
        <Grid Grid.Row="1" x:Name="PetsHalf" IsVisible="False" RowDefinitions="Auto,Auto,Auto,Auto,*,Auto">
            <TextBlock Grid.Row="0" Text="Named mobs in this dimension" Classes="heading" Margin="0,4,0,4" />
            <TextBox Grid.Row="1" x:Name="PetSearchBox" PlaceholderText="Only mobs with these words in their name or kind" FontSize="13" Height="25" Padding="4,1,0,0" />
            <TextBlock Grid.Row="2" x:Name="PetStatusText" Classes="dim" TextWrapping="Wrap" Margin="0,6,0,0" />
            <ProgressBar Grid.Row="3" x:Name="PetProgress" Height="4" MinHeight="4" Margin="0,4,0,6" IsIndeterminate="True" />

            <Border Grid.Row="4" BorderBrush="#FF404040" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF262626" Height="25">
                        <Grid ColumnDefinitions="*,Auto" Margin="8,0,4,0">
                            <TextBlock x:Name="PetSortedText" Classes="dim" FontSize="12" VerticalAlignment="Center" />
                            <Button Grid.Column="1" x:Name="PetSortButton" Classes="flat" Content="Sort from the map's middle" FontSize="12" Padding="6,1" Click="PetSortButton_Click"
                                    ToolTip.Tip="List the nearest to the middle of the map first, from where it is now" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="PetList" Classes="list">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="gui:PetRow">
                                <Grid ColumnDefinitions="Auto,*,Auto" ToolTip.Tip="{Binding ToolTip}">
                                    <CheckBox IsChecked="{Binding Shown, Mode=TwoWay}" IsEnabled="{Binding CanShow}" VerticalAlignment="Center" Margin="0,0,4,0"
                                              ToolTip.Tip="Show it on the map" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding More}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Place}" Classes="dim" FontSize="11" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Distance}" Classes="dim" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <WrapPanel Grid.Row="5" Margin="0,8,0,0">
                <Button x:Name="ShowListedPetsButton" Content="Show all listed" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="ShowListedPetsButton_Click"
                        ToolTip.Tip="Tick every mob in the list" />
                <Button x:Name="HideAllPetsButton" Content="Hide all" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="HideAllPetsButton_Click"
                        ToolTip.Tip="Take every named mob in this dimension off the map" />
                <Button x:Name="PetGoButton" Content="Go there" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="PetGoButton_Click" />
                <Button x:Name="PetPinButton" Content="Add a pin" Classes="dialog" Height="26" Padding="10,0" Margin="0,0,8,4" Click="PetPinButton_Click"
                        ToolTip.Tip="Put a pin where it was, labelled with its name" />
                <TextBlock x:Name="PetPinnedText" Classes="dim" VerticalAlignment="Center" Margin="0,0,0,4" />
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
