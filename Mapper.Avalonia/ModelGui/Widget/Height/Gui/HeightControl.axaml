<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mapper.Gui.HeightControl"
             BorderBrush="#FF3F3F3F" BorderThickness="1"
             Width="74">

    <UserControl.Effect>
        <DropShadowDirectionEffect Direction="-75" ShadowDepth="2" Opacity="1" BlurRadius="6" Color="Black"/>
    </UserControl.Effect>

    <UserControl.Styles>
        <Style Selector="Button.mode">
            <Setter Property="Height" Value="19" />
            <Setter Property="Margin" Value="6,0,6,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="#FF303030" />
            <Setter Property="Foreground" Value="#FFDDDDDD" />
            <Setter Property="BorderBrush" Value="#FF3F3F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.mode.selected">
            <Setter Property="BorderBrush" Value="Gold" />
            <Setter Property="Foreground" Value="Gold" />
        </Style>
    </UserControl.Styles>

    <Grid Background="#FF1C1C1C" RowDefinitions="Auto,7,Auto,Auto,Auto,Auto,Auto">
        <Border BorderBrush="#FF3F3F3F" BorderThickness="0,0,0,1" Grid.Row="0" Height="25" Background="#FF282828">
            <TextBlock Text="Height" FontSize="14" Margin="0,2,0,0" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#FFEEEEEE" />
        </Border>

        <Button x:Name="SurfaceButton" Classes="flat mode" Content="Surface" Grid.Row="2" Click="SurfaceButton_Click"
                ToolTip.Tip="The style's own view" />
        <Button x:Name="SliceButton" Classes="flat mode" Content="Slice" Grid.Row="3" Click="SliceButton_Click"
                ToolTip.Tip="The map as if the world stopped at this height" />
        <Button x:Name="CavesButton" Classes="flat mode" Content="Caves" Grid.Row="4" Click="CavesButton_Click"
                ToolTip.Tip="The floors of the caves below this height" />

        <TextBlock x:Name="HeightLabel" Grid.Row="5" Text="Y 60" FontSize="13" FontWeight="SemiBold" Foreground="#FF95ECF9"
                   HorizontalAlignment="Center" Margin="0,4,0,2" />

        <Slider x:Name="HeightSlider" Grid.Row="6" Orientation="Vertical" Height="200" Margin="0,0,0,8"
                HorizontalAlignment="Center" SmallChange="1" LargeChange="16" IsSnapToTickEnabled="True" TickFrequency="1"
                ToolTip.Tip="Drag, or scroll here (hold Shift for steps of 10)" />
    </Grid>
</UserControl>
