<Project Sdk="Microsoft.NET.Sdk">

  <!-- Drives the Avalonia GUI headless with real (Skia) rendering and saves screenshots, so it can be checked without a display -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Mapper.Avalonia\Mapper.Avalonia.csproj" />
  </ItemGroup>

</Project>
