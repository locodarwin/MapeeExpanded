<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mapper.Gui.MarkupBar"
             BorderBrush="#FF3F3F3F" BorderThickness="1">

    <UserControl.Effect>
        <DropShadowDirectionEffect Direction="-75" ShadowDepth="2" Opacity="1" BlurRadius="6" Color="Black"/>
    </UserControl.Effect>

    <UserControl.Styles>
        <Style Selector="Button.mode">
            <Setter Property="Height" Value="22" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="#FF303030" />
            <Setter Property="Foreground" Value="#FFDDDDDD" />
            <Setter Property="BorderBrush" Value="#FF3F3F3F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.mode.selected">
            <Setter Property="BorderBrush" Value="Gold" />
            <Setter Property="Foreground" Value="Gold" />
        </Style>
        <Style Selector="Border.gap">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="4,2,8,2" />
            <Setter Property="Background" Value="#FF3F3F3F" />
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="MinHeight" Value="0" />
        </Style>
    </UserControl.Styles>

    <StackPanel Background="#FF1C1C1C">
        <StackPanel Orientation="Horizontal" Margin="6,5,2,4">
            <Button x:Name="PinButton" Classes="flat mode" Content="Pin" Click="PinButton_Click"
                    ToolTip.Tip="Click the map to drop a pin (P)" />
            <Button x:Name="ZoneButton" Classes="flat mode" Content="Zone" Click="ZoneButton_Click"
                    ToolTip.Tip="Click the corners of a zone (Z)" />
            <Button x:Name="RectangleButton" Classes="flat mode" Content="Rectangle" Click="RectangleButton_Click"
                    ToolTip.Tip="Drag out a rectangular zone (R)" />
            <Button x:Name="SelectButton" Classes="flat mode" Content="Select" Click="SelectButton_Click"
                    ToolTip.Tip="Pick, move and edit pins and zones (V)" />
            <Border Classes="gap" />
            <Button x:Name="PlacesButton" Classes="flat mode" Content="Places" Click="PlacesButton_Click"
                    ToolTip.Tip="Every pin and zone in this dimension" />
            <Button x:Name="UndoButton" Classes="flat mode" Content="Undo" Click="UndoButton_Click" ToolTip.Tip="Undo (Ctrl+Z)" />
            <Button x:Name="RedoButton" Classes="flat mode" Content="Redo" Click="RedoButton_Click" ToolTip.Tip="Redo (Ctrl+Y)" />
            <Border Classes="gap" />
            <Button x:Name="ExportButton" Classes="flat mode" Content="Export..." Click="ExportButton_Click"
                    ToolTip.Tip="Save this world's markup to a file" />
            <Button x:Name="ImportButton" Classes="flat mode" Content="Import..." Click="ImportButton_Click"
                    ToolTip.Tip="Add the markup saved in a file" />
            <Button x:Name="HideButton" Classes="flat mode" Content="Hide" Click="HideButton_Click"
                    ToolTip.Tip="Hide pins and zones until the Markup button or Shift+M brings them back" />
        </StackPanel>
        <TextBlock x:Name="HintText" Foreground="#FFAAAAAA" FontSize="11" Margin="7,0,7,5" TextWrapping="Wrap" MaxWidth="560"
                   HorizontalAlignment="Left" />

        <Popup x:Name="EditPopup" Placement="AnchorAndGravity" PlacementAnchor="Bottom" PlacementGravity="Bottom"
               IsLightDismissEnabled="True" />

        <Popup x:Name="PlacesPopup" Placement="Bottom" IsLightDismissEnabled="True">
            <Border Background="#FF1C1C1C" BorderBrush="#FF707070" BorderThickness="1" Width="300">
                <StackPanel>
                    <TextBox x:Name="PlacesFilter" Height="24" Margin="6" FontSize="12" Padding="4,1" PlaceholderText="Find" />
                    <TextBlock x:Name="PlacesEmpty" Foreground="#FFAAAAAA" FontSize="12" Margin="8,0,8,8" TextWrapping="Wrap"
                               Text="Nothing marked in this dimension yet." />
                    <ListBox x:Name="PlacesList" MaxHeight="320" Background="Transparent" Margin="0,0,0,4" />
                </StackPanel>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
