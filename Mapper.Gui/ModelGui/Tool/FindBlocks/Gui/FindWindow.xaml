<Window x:Class="Mapper.Gui.FindWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        BorderBrush="#FF454545"
        BorderThickness="1"
        ResizeMode="CanResize"
        UseLayoutRounding="True"
        Icon="/Resources/Icon/ToolButton/Find_64px.ico"
        Template="{DynamicResource CustomWindowFrameTemplate}"
        Title="Find" Height="740" Width="470" MinWidth="390" MinHeight="540" Background="#FF232323" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded">

    <WindowChrome.WindowChrome>
        <WindowChrome GlassFrameThickness="0" CornerRadius="0" CaptionHeight="0" UseAeroCaptionButtons="False" ResizeBorderThickness="7"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Template/CustomWindowFrameTemplate.xaml"/>
                <ResourceDictionary Source="/Resources/Template/ScrollBarStyle.xaml"/>
                <ResourceDictionary Source="/Resources/Template/TextBoxStyle.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFEEEEEE"/>
            </Style>
            <Style x:Key="Dim" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFBBBBBB"/>
            </Style>
            <Style x:Key="Heading" TargetType="{x:Type TextBlock}">
                <Setter Property="Foreground" Value="#FFEEEEEE"/>
                <Setter Property="FontWeight" Value="Bold"/>
                <Setter Property="FontSize" Value="15"/>
            </Style>

            <Style TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="#FFEEEEEE"/>
                <Setter Property="Background" Value="#FF353535"/>
                <Setter Property="BorderBrush" Value="#FF505050"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="8,2"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FF454545"/>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter Property="Background" Value="#FF606060"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="#FF707070"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- The Blocks and Signs switch; the half on show is gold -->
            <Style x:Key="Half" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="90"/>
                <Setter Property="Height" Value="26"/>
                <Setter Property="Margin" Value="0,0,6,0"/>
                <Style.Triggers>
                    <Trigger Property="Tag" Value="on">
                        <Setter Property="BorderBrush" Value="#FFE0B040"/>
                        <Setter Property="Foreground" Value="#FFE0B040"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="Flat" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="5,0"/>
            </Style>

            <Style TargetType="{x:Type ListBox}">
                <Setter Property="Background" Value="#FF191919"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            </Style>
            <!-- Text in the rows takes its colour from here: the window's TextBlock style doesn't reach into templates -->
            <Style TargetType="{x:Type ListBoxItem}">
                <Setter Property="Foreground" Value="#FFEEEEEE"/>
                <Setter Property="Padding" Value="8,3"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ListBoxItem}">
                            <Border x:Name="Back" Background="Transparent" Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#FF2C2C2C"/>
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Back" Property="Background" Value="#FF3A4A5A"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Blocks or signs: a switch on top, and the half picked below it -->
    <Grid Margin="15,10,15,15" Grid.Row="1">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,4">
            <Button x:Name="BlocksButton" Style="{StaticResource Half}" Content="Blocks" Click="BlocksButton_Click" ToolTip="Find blocks anywhere in the dimension"/>
            <Button x:Name="SignsButton" Style="{StaticResource Half}" Content="Signs" Click="SignsButton_Click" ToolTip="List the signs and what they say, and pick which to show on the map"/>
        </StackPanel>

        <Grid Grid.Row="1" x:Name="BlocksHalf">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="110"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Look for" Style="{StaticResource Heading}" Margin="0,4,0,4"/>
            <Grid Grid.Row="1">
                <TextBox x:Name="SearchBox" FontSize="13" Height="25" Padding="4,1,0,0" TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown"/>
                <TextBlock IsHitTestVisible="False" Text="Search blocks (Enter or double-click adds one)" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="7,0,0,1" Foreground="#FF969696">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border Grid.Row="2" BorderBrush="#FF404040" BorderThickness="1" Margin="0,3,0,0">
                <ListBox x:Name="BlockList" MouseDoubleClick="BlockList_MouseDoubleClick" KeyDown="BlockList_KeyDown">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"/>
                                <TextBlock Text="{Binding Id}" Style="{StaticResource Dim}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <ItemsControl Grid.Row="3" x:Name="GroupButtons" Margin="0,6,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Label}" Margin="0,0,4,4" Height="24" FontSize="12" Click="GroupButton_Click"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ItemsControl Grid.Row="4" x:Name="ChipList" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#FF303030" BorderBrush="#FF505050" BorderThickness="1" CornerRadius="3" Margin="0,0,5,5" Padding="6,2,2,2" ToolTip="{Binding ToolTip}">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                <Button Content="×" Style="{StaticResource Flat}" FontSize="14" Margin="4,0,0,0" ToolTip="Take it off" Click="RemoveChip_Click"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,4,0,0">
                <TextBlock Text="From Y" VerticalAlignment="Center"/>
                <TextBox x:Name="FromBox" Width="64" Height="25" Padding="4,1,0,0" Margin="6,0,0,0" ToolTip="Leave blank for any height" KeyDown="HeightBox_KeyDown"/>
                <TextBlock Text="to Y" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="ToBox" Width="64" Height="25" Padding="4,1,0,0" Margin="6,0,0,0" ToolTip="Leave blank for any height" KeyDown="HeightBox_KeyDown"/>
            </StackPanel>

            <StackPanel Grid.Row="6" Orientation="Horizontal" Margin="0,10,0,0">
                <Button x:Name="FindButton" Content="Find" Width="90" Height="26" BorderBrush="#FF528753" Click="FindButton_Click"/>
                <Button x:Name="StopButton" Content="Stop" Width="70" Height="26" Margin="8,0,0,0" Click="StopButton_Click"/>
            </StackPanel>
            <TextBlock Grid.Row="7" x:Name="StatusText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <ProgressBar Grid.Row="8" x:Name="Progress" Height="4" Margin="0,4,0,0" Minimum="0" Maximum="1" Background="#FF303030" BorderThickness="0" Foreground="#FF528753"/>

            <TextBlock Grid.Row="9" x:Name="CountsText" Style="{StaticResource Dim}" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,3"/>

            <Border Grid.Row="10" BorderBrush="#FF404040" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF262626" Height="25">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SortedText" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="SortButton" Style="{StaticResource Flat}" Content="Sort from the map's middle" FontSize="12" Padding="6,1" Click="SortButton_Click"
                                    ToolTip="List the nearest to the middle of the map first, from where it is now"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="ResultList" SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="11" Height="11" CornerRadius="2" Background="{Binding Color}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}"/>
                                        <TextBlock Text="{Binding Place}" Style="{StaticResource Dim}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Distance}" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="11" Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="GoButton" Content="Go there" Width="90" Height="26" Click="GoButton_Click"/>
                <Button x:Name="PinButton" Content="Add a pin" Width="90" Height="26" Margin="8,0,0,0" Click="PinButton_Click"
                        ToolTip="Put a pin on it, labelled with what it is and how deep"/>
                <TextBlock x:Name="PinnedText" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Nothing is drawn for a sign until its box is ticked -->
        <Grid Grid.Row="1" x:Name="SignsHalf" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Signs in this dimension" Style="{StaticResource Heading}" Margin="0,4,0,4"/>
            <Grid Grid.Row="1">
                <TextBox x:Name="SignSearchBox" FontSize="13" Height="25" Padding="4,1,0,0" TextChanged="SignSearchBox_TextChanged"/>
                <TextBlock IsHitTestVisible="False" Text="Only signs saying these words (either side)" FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left" Margin="7,0,0,1" Foreground="#FF969696">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SignSearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <CheckBox Grid.Row="2" x:Name="BlankBox" Content="Include blank signs" Foreground="#FFEEEEEE" Margin="0,8,0,0" Checked="BlankBox_Changed" Unchecked="BlankBox_Changed"/>
            <TextBlock Grid.Row="3" x:Name="SignStatusText" Style="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            <ProgressBar Grid.Row="4" x:Name="SignProgress" Height="4" Margin="0,4,0,6" IsIndeterminate="True" Background="#FF303030" BorderThickness="0" Foreground="#FF528753"/>

            <Border Grid.Row="5" BorderBrush="#FF404040" BorderThickness="1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#FF262626" Height="25">
                        <Grid Margin="8,0,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SignSortedText" Style="{StaticResource Dim}" FontSize="12" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" x:Name="SignSortButton" Style="{StaticResource Flat}" Content="Sort from the map's middle" FontSize="12" Padding="6,1" Click="SignSortButton_Click"
                                    ToolTip="List the nearest to the middle of the map first, from where it is now"/>
                        </Grid>
                    </Border>
                    <ListBox x:Name="SignList" SelectionChanged="SignList_SelectionChanged" MouseDoubleClick="SignList_MouseDoubleClick">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ToolTip="{Binding ToolTip}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding Shown, Mode=TwoWay}" IsEnabled="{Binding CanShow}" VerticalAlignment="Center" Margin="0,0,8,0" ToolTip="Show it on the map"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding More}" FontSize="12" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="{x:Type TextBlock}">
                                                    <Setter Property="Foreground" Value="#FFEEEEEE"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMore}" Value="False">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Place}" Style="{StaticResource Dim}" FontSize="11"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding Distance}" Style="{StaticResource Dim}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <WrapPanel Grid.Row="6" Margin="0,8,0,0">
                <Button x:Name="ShowListedButton" Content="Show all listed" Height="26" Padding="10,0" Margin="0,0,8,4" Click="ShowListedButton_Click" ToolTip="Tick every sign in the list"/>
                <Button x:Name="HideAllButton" Content="Hide all" Height="26" Padding="10,0" Margin="0,0,8,4" Click="HideAllButton_Click" ToolTip="Take every sign in this dimension off the map"/>
                <Button x:Name="SignGoButton" Content="Go there" Height="26" Padding="10,0" Margin="0,0,8,4" Click="SignGoButton_Click"/>
                <Button x:Name="SignPinButton" Content="Add a pin" Height="26" Padding="10,0" Margin="0,0,8,4" Click="SignPinButton_Click" ToolTip="Put a pin on it, labelled with its first line"/>
                <TextBlock x:Name="SignPinnedText" Style="{StaticResource Dim}" VerticalAlignment="Center" Margin="0,0,0,4"/>
            </WrapPanel>
        </Grid>
    </Grid>
</Window>
