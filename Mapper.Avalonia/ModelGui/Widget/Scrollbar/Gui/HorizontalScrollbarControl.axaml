<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mapper.Gui.HorizontalScrollbarControl"
             Background="#FF141414">
    <DockPanel Margin="7,0,2,0">
        <ScrollBar x:Name="ScrollbarControl" Orientation="Horizontal" Background="{x:Null}" />
    </DockPanel>
</UserControl>
